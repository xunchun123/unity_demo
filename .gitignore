# Unity 生成的临时文件
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/

# 内存快照与崩溃报告
sysinfo.txt
*.stackdump
*.pid
*.meta.tmp

# IDE 文件
.vs/
.idea/
*.csproj
*.sln
*.user
*.userprefs
.vscode/

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# 系统文件
.DS_Store
Thumbs.db

# 本地工具产物（安全扫描钩子的会话状态，不属于项目）
.mimosa/


# 字体源文件不入库（系统字体禁止再分发；构建脚本会从系统目录自动复制）
Assets/Fonts/*.ttf
Assets/Fonts/*.otf
Assets/Fonts/*.ttc
